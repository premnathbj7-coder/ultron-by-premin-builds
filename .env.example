# Server-side Gemini API key for natural-language voice/command intent detection
GEMINI_API_KEY=

# Optional public WebSocket/HTTP base URL advertised inside QR pairing payloads (auto-detected from request Host if omitted)
ULTRON_PUBLIC_URL=

# Optional TLS certificate paths when running WSS/HTTPS directly on Node (otherwise terminate TLS via reverse proxy)
ULTRON_TLS_KEY_PATH=
ULTRON_TLS_CERT_PATH=
